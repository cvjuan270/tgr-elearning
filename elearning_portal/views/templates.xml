<odoo>
    <!-- Oculta Tiempo de finalizacion y Miembros del web -->
    <template id="course_sidebar" inherit_id="website_slides.course_sidebar">
        <xpath expr="//div[@id='o_wslides_sidebar_collapse']" position="replace">
            <div id="o_wslides_sidebar_collapse">
                <table class="table table-sm mt-3">
                    <tr t-if="channel.user_id">
                        <th class="border-top-0">Responsable</th>
                        <td class="border-top-0 text-break">
                            <span t-esc="channel.user_id.display_name"></span>
                        </td>
                    </tr>
                    <tr>
                        <th class="border-top-0">Última actualización</th>
                        <td class="border-top-0">
                            <t t-esc="channel.slide_last_update" t-options="{'widget': 'date'}"></t>
                        </td>
                    </tr>
                </table>
            </div>
        </xpath>
    </template>
</odoo>
