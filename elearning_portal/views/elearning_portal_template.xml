<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template customize_show="True" id="portal_my_home_elearning" inherit_id="portal.portal_my_home" name="Show Courses" priority="20">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Mis Cursos</t>
                <t t-set="url" t-value="'/slides'"></t>
                <t t-set="placeholder_count" t-value="'slide_channel_count'"></t>
            </t>
        </xpath>
    </template>
</odoo>
